{
  "name": "formulon-homepage",
  "version": "1.0.0",
  "description": "Documentation site for Formulon",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "homepage": "https://formulon.libraz.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libraz/formulon-homepage.git"
  },
  "scripts": {
    "dev": "vitepress dev",
    "dev:local": "node scripts/check-demo-packages.mjs && FORMULON_DEMO_SOURCE=local yarn dev",
    "build": "node scripts/check-facts.mjs && node scripts/gen-api-reference.mjs --check && vitepress build && node scripts/check-docs.mjs",
    "build:local": "node scripts/check-demo-packages.mjs && FORMULON_DEMO_SOURCE=local yarn build",
    "preview": "node scripts/preview.mjs",
    "check:facts": "node scripts/check-facts.mjs",
    "gen:api": "node scripts/gen-api-reference.mjs",
    "check:api": "node scripts/gen-api-reference.mjs --check",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "lint": "biome check src .vitepress vitest.config.ts",
    "lint:fix": "biome check --write src .vitepress vitest.config.ts",
    "format": "biome format --write src .vitepress vitest.config.ts",
    "test": "vitest run",
    "test:local": "node scripts/check-demo-packages.mjs && FORMULON_DEMO_SOURCE=local yarn test",
    "test:watch": "vitest",
    "test:install": "playwright install chromium",
    "demos:prepare": "node scripts/prepare-demo-packages.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:demos": "node scripts/check-demo-packages.mjs"
  },
  "keywords": [
    "excel",
    "spreadsheet",
    "calculation-engine",
    "wasm",
    "python",
    "cpp"
  ],
  "author": "libraz <libraz@libraz.net>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser-playwright": "5.0.5",
    "@vue/compiler-dom": "^3.5.44",
    "@vue/test-utils": "2.5.1",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@libraz/formulon": "0.18.0",
    "@libraz/formulon-cell": "0.12.0",
    "@libraz/formulon-cell-vue": "0.12.0",
    "vue": "^3.5.44",
    "zustand": "^5.0.16"
  },
  "resolutions": {
    "@libraz/formulon": "0.18.0",
    "@libraz/formulon-cell": "0.12.0",
    "@libraz/formulon-cell-vue": "0.12.0"
  }
}
